# Copy this file to .env and fill in your keys.
# GLM coding-plan API key from https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# Optional: model used for the GLM auto-arm ping (default: glm-4.5-air)
ZAI_PING_MODEL=

# All OAuth logins (Claude, Codex, Grok) are owned by this dashboard and
# stored in its own credential store; other CLIs' credential files are never
# read or written. Defaults:
#   ~/.local/share/usage-dashboard/auth.json      (AUTH_STORE_PATH)
#   ~/.local/share/usage-dashboard/settings.json  (SETTINGS_PATH)
AUTH_STORE_PATH=
SETTINGS_PATH=
HISTORY_PATH=

# Set to "false" to hide the Claude (Max) card.
CLAUDE_ENABLED=

# Optional: model used for the Claude auto-arm ping (default: claude-haiku-4-5)
CLAUDE_PING_MODEL=

# Set to "false" to hide the Grok card.
GROK_ENABLED=
